# Скопировать в .env и заполнить.  cp .env.example .env

# ─── Postgres ───────────────────────────────────────────────────────────
PG_USER=tzoar
PG_PASSWORD=CHANGE_ME
PG_DB=tzoar

# ─── MinIO / S3 ─────────────────────────────────────────────────────────
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME_TOO
S3_BUCKET=tzoar-artifacts
S3_ENDPOINT=http://minio:9000

# ─── GPU-бэкенд ─────────────────────────────────────────────────────────
# contabo | runpod | vast | local.  Пустой GPU_NODE_URL => NullBackend:
# конвейер честно останавливается на стадии рендера вместо имитации работы.
GPU_BACKEND=contabo
GPU_NODE_URL=
# Ставка в час на момент запуска — пишется в журнал стоимости.
# Contabo L40S dedicated: 600 EUR/мес ÷ 730 ч ≈ 0.82 EUR/ч при 100% загрузке.
GPU_PRICE_PER_HOUR=0.0

# ─── Корпус ─────────────────────────────────────────────────────────────
# Хеш снимка корпуса. Без него запись атласа не может быть утверждена.
CORPUS_SNAPSHOT=unset

# ─── Публикация ─────────────────────────────────────────────────────────
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_CHANNEL_RU=
YT_CHANNEL_EN=
TELEGRAM_BOT_TOKEN=
LINKEDIN_TOKEN=
