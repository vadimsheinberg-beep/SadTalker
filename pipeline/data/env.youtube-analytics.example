# Own-channel analytics (TAMHA = RU, Iahalom = EN).
#
# Deploy to /opt/tzoar/deploy/.env.youtube-analytics with mode 0600.
# This file is a TEMPLATE: it must never contain real values in the repository.
#
#   chmod 600 /opt/tzoar/deploy/.env.youtube-analytics
#
# Refresh tokens do not expire on their own. Treat them exactly like passwords.
# If one is ever pasted into chat, an issue tracker, or a log, it is burned:
# revoke it at https://myaccount.google.com/permissions (Third-party access ->
# the app -> Remove access) and run the OAuth consent flow again. Rotating the
# client secret alone does NOT invalidate an already-issued refresh token.
#
# Scope needed: https://www.googleapis.com/auth/yt-analytics.readonly
# Each token is issued by the Google account that owns that channel, so the two
# tokens come from two separate consent flows under two different accounts.

YT_ANALYTICS_CLIENT_ID=
YT_ANALYTICS_CLIENT_SECRET=

# RU channel: TAMHA — https://www.youtube.com/@tamha4
YT_ANALYTICS_REFRESH_TOKEN_RU=

# EN channel: Iahalom — https://www.youtube.com/@Tamha2
YT_ANALYTICS_REFRESH_TOKEN_EN=
